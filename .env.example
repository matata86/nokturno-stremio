# Zkopíruj na .env a vyplň. Stejné hodnoty jako v doplňku pro Kodi —
# u obojího jde místo hesla použít i hotový hash, viz README.
NOKTURNO_WS_USERNAME=
NOKTURNO_WS_PASSWORD=
NOKTURNO_STREAMUJ_USERNAME=
NOKTURNO_STREAMUJ_PASSWORD=

# Luna se ve Stremiu nepoužívá — má vlastní doplněk a odkazy do domácí sítě

NOKTURNO_HS_ENABLED=1
NOKTURNO_PREF_LANG=CZ
NOKTURNO_SORT=quality
NOKTURNO_HIDE_SD=0
