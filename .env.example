# Zkopíruj na .env a vyplň. Stejné hodnoty jako v doplňku pro Kodi —
# u obojího jde místo hesla použít i hotový hash, viz README.
NOKTURNO_WS_USERNAME=
NOKTURNO_WS_PASSWORD=
NOKTURNO_STREAMUJ_USERNAME=
NOKTURNO_STREAMUJ_PASSWORD=

# Sledujteto — hledání chce účet, přehrávání Premium
NOKTURNO_ST_EMAIL=
NOKTURNO_ST_PASSWORD=

# FastShare — hledá se i bez účtu, přehrání z kreditu nebo neomezeného tarifu.
# NOKTURNO_FS_PROVIDER=sdilej, když je účet ze Sdilej.cz (týž katalog, jiné účty)
NOKTURNO_FS_USERNAME=
NOKTURNO_FS_PASSWORD=
NOKTURNO_FS_PROVIDER=

# Přehraj.to — s Premium účtem původní soubor, bez něj jen překódovaný
NOKTURNO_PT_EMAIL=
NOKTURNO_PT_PASSWORD=

# Luna se ve Stremiu nepoužívá — má vlastní doplněk a odkazy do domácí sítě

NOKTURNO_HS_ENABLED=1
NOKTURNO_PREF_LANG=CZ
NOKTURNO_SORT=quality
NOKTURNO_HIDE_SD=0

# Klíč TMDB instance pro katalogy TMDB; ve formuláři se nezadává
NOKTURNO_TMDB_KEY=

# Vlastní úložiště (WebDAV), až tři — adresa složky, jméno, heslo, název u streamu
NOKTURNO_DAV1_URL=
NOKTURNO_DAV1_USERNAME=
NOKTURNO_DAV1_PASSWORD=
NOKTURNO_DAV1_NAME=
NOKTURNO_DAV2_URL=
NOKTURNO_DAV2_USERNAME=
NOKTURNO_DAV2_PASSWORD=
NOKTURNO_DAV2_NAME=
NOKTURNO_DAV3_URL=
NOKTURNO_DAV3_USERNAME=
NOKTURNO_DAV3_PASSWORD=
NOKTURNO_DAV3_NAME=

# Provoz: na čem poslouchat (v Dockeru 0.0.0.0, za reverzní proxy 127.0.0.1), port, složka s cache
NOKTURNO_HOST=0.0.0.0
NOKTURNO_PORT=7127
NOKTURNO_DATA=./data
# Tajemství pro podepsanou identitu v adrese (limity na uživatele), např. `openssl rand -hex 32`.
# Prázdné = identita se nevydává, limity platí na nastavení.
NOKTURNO_ID_SECRET=
# Anonymní statistiky (0 = jen ping „nastavení žije"); předvyplnit formulář účty z prostředí — JEN na vlastní instanci
NOKTURNO_STATS=1
NOKTURNO_CONFIGURE_PREFILL=0
# Hlášení o pádech služby (0 = vypnuto)
NOKTURNO_CRASH_REPORTS=1
# Hlášení provozu do dashboardu (obrazovka Provoz) — jen na instanci, kde běží
# dashboard vedle. Bez tokenu se nic neměří ani neposílá; `NOKTURNO_TRAFFIC=0` vypne.
NOKTURNO_TRAFFIC=1
NOKTURNO_TRAFFIC_URL=http://127.0.0.1:8080/traffic
NOKTURNO_TRAFFIC_TOKEN=
